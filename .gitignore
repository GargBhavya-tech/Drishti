logs/
runs/
outputs/
wandb/
mlruns/
*.log
*.out
*.err

# ------ IDEs & Editors ------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ------ OS ------
ehthumbs.db
Desktop.ini

