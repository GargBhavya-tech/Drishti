__pycache__/
*.pyc
.pytest_cache/
eval/out/*
!eval/out/*.png
data/
brag-output/
brag-output-2026-09-20-192621/
# `data/` above targets the RELLIS-3D dataset at the repo root
# (data/rellis/...) -- gitignore patterns with no leading slash match a
# directory of that name at ANY depth, so it was also silently excluding
# frontend/public/data/, the exported real-data demo the frontend needs
# to actually show anything. Un-ignore it explicitly (a directory-level
# ignore blocks even the `!frontend/**/*.json` exception below from ever
# taking effect, so this negation has to name the directory itself).
!frontend/public/data/
!frontend/public/data/**
*.egg-info/
.DS_Store
*.zip

# ------ Training outputs (generated, not source) ------
*.pt             # model checkpoints (large binaries)
*.pth
*.npz
checkpoints/
checkpoints_*/
checkpoints_remote/
checkpoints_multi_remote/
checkpoints_multi_v2_remote/
channel_stats.json
val_metrics_epoch*.json

# ------ JSON runtime outputs ------
*.json
!frontend/**/*.json
!story/**/*.json
