*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg
lib/
lib64/
MANIFEST

# ------ Virtual Environments ------
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.conda/
conda-env/

# ------ Jupyter / IPython ------
.ipynb_checkpoints/
*.ipynb_checkpoints
profile_default/
ipython_config.py

# ------ Testing / Coverage ------
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.hypothesis/
.pytest_cache/
pytestdebug.log

# ------ Type Checking ------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

